generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Application user. Login identity is `username`. Never hard-deleted — use isActive.
model User {
  id                       String                      @id @default(cuid())
  name                     String
  username                 String                      @unique
  passwordHash             String
  role                     Role
  phone                    String?
  email                    String?                     @unique
  isActive                 Boolean                     @default(true)
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  deletedAt                DateTime?
  sessionValidAfter        DateTime?
  groupId                  String?
  territory                String?
  /// Display only; never used to authorize an account.
  designation              String?
  /// Explicit module -> action grants for CUSTOM_ADMIN only. Existing roles ignore this field.
  adminPermissions         Json                        @default("{}")
  accountManagementOwner   AccountManagementOwner?
  recoveryUploads          AgingSnapshot[]             @relation("RecoveryUploads")
  targetedAnnouncements    Announcement[]              @relation("AnnouncementTargetUser")
  announcementReads        AnnouncementReadStatus[]
  approvalActions          ApprovalAction[]
  auditLogs                AuditLog[]
  calendarEntries          CalendarEntry[]             @relation("CalendarEntryOwner")
  calendarNotes            CalendarNote[]              @relation("CalendarNoteOwner")
  cnPaymentEvents          CnPaymentEvent[]            @relation("CnPaymentEventRecordedBy")
  cnRequests               CnRequest[]                 @relation("OfficerCnRequests")
  dailyWorkAttendance      DailyWorkAttendance[]       @relation("DailyWorkAttendanceOfficer")
  dailyWorkDays            DailyWorkDay[]              @relation("DailyWorkDayOfficer")
  marketRequests           MarketRequest[]             @relation("MarketRequestRequester")
  seasonalPlans            SeasonalPlan[]              @relation("SeasonalPlanOwner")
  partyMonthlyPlans        PartyMonthlyPlan[]          @relation("PartyMonthlyPlanOwner")
  seasonalSheets           SeasonalPlanSheet[]         @relation("SeasonalSheetOwner")
  partyMonthlySheets       PartyMonthlySheet[]         @relation("PartyMonthlySheetOwner")
  dailyWorkEntries         DailyWorkEntry[]            @relation("DailyWorkOfficer")
  dailyWorkReviews         DailyWorkReview[]           @relation("DailyWorkReviewOfficer")
  dailyWorkReviewsGiven    DailyWorkReview[]           @relation("DailyWorkReviewReviewer")
  dealerAssignments        DealerAssignment[]          @relation("OfficerDealers")
  importRecords            DealerImportRecord[]
  enrolledSchemePlans      DealerSchemePlan[]          @relation("EnrolledSchemePlans")
  rmActedSchemePlans       DealerSchemePlan[]          @relation("RmActedSchemePlans")
  schemePlans              DealerSchemePlan[]          @relation("OfficerSchemePlans")
  dealerTagRequests        DealerTagRequest[]
  lastPaymentImports       LastPaymentImport[]
  decidedExtensions        MonthExtensionRequest[]     @relation("ExtensionDecidedBy")
  requestedExtensions      MonthExtensionRequest[]     @relation("ExtensionRequestedBy")
  monthlyPlans             MonthlyPlan[]               @relation("OfficerMonthlyPlans")
  notifications            Notification[]
  onboardingRuns           OnboardingRecord[]          @relation("OnboardingRuns")
  partyPlans               PartyPlan[]                 @relation("PartyPlanOfficer")
  recoveryPlans            RecoveryPlan[]              @relation("OfficerRecoveryPlans")
  asManagerRmAssignments   RmAssignment[]              @relation("ManagerRm")
  asOfficerRmAssignments   RmAssignment[]              @relation("OfficerRm")
  salesUploads             SalesUploadRun[]            @relation("SalesUploads")
  createdSchemes           Scheme[]                    @relation("SchemeCreatedBy")
  conversionExtensions     SchemeConversionExtension[] @relation("ConversionExtendedBy")
  schemePayments           SchemePayment[]             @relation("SchemePaymentCreatedBy")
  schemePlanQuantitySplits SchemePlanQuantitySplit[]   @relation("SchemePlanQuantitySplitCreatedBy")
  schemeUploadBatches      SchemeUploadBatch[]         @relation("SchemeUploadBatches")
  seasonPlans              SeasonPlan[]                @relation("OfficerPlans")
  planImportRecords        SeasonPlanImportRecord[]    @relation("PlanImports")
  group                    UserGroup?                  @relation(fields: [groupId], references: [id])
  territoryMarketEdits     TerritoryMarketEdit[]       @relation("TerritoryMarketEditor")

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@index([groupId])
}

/// A group of Sales Officers (e.g. MP / UP / WB / CG). One officer belongs to one group.
model UserGroup {
  id               String                  @id @default(cuid())
  name             String                  @unique
  description      String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  productCatalogue GroupProductCatalogue[]
  schemeStates     SchemeState[]
  members          User[]
  districts        District[]
}

/// Commercial Scheme Master. This is intentionally independent of sales planning in Phase 1;
/// later Scheme Planning will consume these definitions without changing their history.
model Scheme {
  id                    String                       @id @default(cuid())
  schemeName            String
  startDate             DateTime?
  endDate               DateTime?
  bookingLastDate       DateTime?
  schemeValueWithoutGST Decimal?                     @db.Decimal(14, 2)
  schemeBenefit         SchemeBenefit
  allowMultipleSchemes  Boolean                      @default(false)
  documentUrl           String?
  status                SchemeStatus                 @default(OPEN)
  createdById           String
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  schemeValueWithGST    Decimal?                     @db.Decimal(14, 2)
  isPerpetual           Boolean                      @default(false)
  benefitDetails        String?
  bookingAmount         Decimal?                     @db.Decimal(14, 2)
  otherBenefitDetails   String?
  maxExtensionDays      Int                          @default(0)
  maxExtensionAttempts  Int                          @default(0)
  requirementType       SchemeRequirementType        @default(NONE)
  valueMode             SchemeValueMode?
  combinedRequiredValue Decimal?                     @db.Decimal(14, 2)
  structure             SchemeStructure              @default(FIXED)
  optionAchievementType SchemeOptionAchievementType?
  prePlacementMaxDays   Int                          @default(0)
  installmentBalance    Boolean                      @default(false)
  numberOfBills         Int                          @default(5)
  dailyWorkEntries      DailyWorkEntry[]
  dealerPlans           DealerSchemePlan[]
  createdBy             User                         @relation("SchemeCreatedBy", fields: [createdById], references: [id])
  eligibleProducts      SchemeEligibleProduct[]
  installmentRules      SchemeInstallmentRule[]
  options               SchemeOption[]
  requirementProducts   SchemeRequirementProduct[]
  states                SchemeState[]
  uploadScopes          SchemeUploadBatchScheme[]

  @@index([status])
  @@index([isPerpetual, endDate])
  @@index([createdById])
}

/// How the Scheme Value (With GST) is paid out — one row per installment. Percentage rules sum to 100%;
/// fixed-amount rules sum to the Scheme Value (With GST). Validated when saved with the scheme.
model SchemeInstallmentRule {
  id                   String         @id @default(cuid())
  schemeId             String
  installmentNumber    Int
  calculationType      SchemeCalcType
  value                Decimal        @db.Decimal(14, 2)
  daysAfterBillingDate Int
  scheme               Scheme         @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, installmentNumber])
  @@index([schemeId])
}

/// A dealer planned into a scheme by a Sales Officer. Two independent tracks:
/// planningStatus (SO submit → RM approve/reject/return) and enrollmentStatus (Admin document
/// verification → ENROLLED). RM approval is planning approval only; it does NOT enroll the dealer.
model DealerSchemePlan {
  id                       String                      @id @default(cuid())
  schemeId                 String
  dealerId                 String
  salesOfficerId           String
  planningStatus           SchemePlanStatus            @default(DRAFT)
  enrollmentStatus         SchemeEnrollmentStatus      @default(PENDING_DOCUMENT)
  submittedAt              DateTime?
  rmActedById              String?
  rmActedAt                DateTime?
  rmRemarks                String?
  documentCompleted        Boolean                     @default(false)
  documentType             SchemeDocType?
  verificationRemarks      String?
  enrolledById             String?
  enrolledAt               DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  expectedBillingDate      DateTime?
  planStatus               SchemePlanState             @default(DRAFT)
  schemeStatus             SchemeConversionStatus      @default(PENDING)
  numberOfSchemes          Int                         @default(1)
  totalSchemeAmount        Decimal?                    @db.Decimal(14, 2)
  conversionDate           DateTime?
  soBookingStatus          SchemeBookingStatus?
  soBookingAmount          Decimal?                    @db.Decimal(14, 2)
  soDocumentStatus         SchemeSoDocStatus?
  billingDate              DateTime?
  adminBookingStatus       SchemeBookingStatus?
  adminBookingAmount       Decimal?                    @db.Decimal(14, 2)
  adminDocumentStatus      SchemeAdminDocStatus?
  adminVerifiedById        String?
  adminVerifiedAt          DateTime?
  adminConversionDate      DateTime?
  adminBillingDate         DateTime?
  soBillingSameForAll      Boolean                     @default(true)
  adminBillingSameForAll   Boolean                     @default(true)
  soNote                   String?
  originalConversionDate   DateTime?
  conversionExtensionCount Int                         @default(0)
  selectedOptionId         String?
  optionLabel              String?
  optionTargetQty          Decimal?                    @db.Decimal(14, 3)
  optionTargetValue        Decimal?                    @db.Decimal(14, 2)
  optionValueWithoutGST    Decimal?                    @db.Decimal(14, 2)
  optionValueWithGST       Decimal?                    @db.Decimal(14, 2)
  prePlacementDays         Int?
  adminPrePlacementDays    Int?
  optionBookingAmount      Decimal?                    @db.Decimal(14, 2)
  installmentBalance       Boolean                     @default(false)
  billMode                 Boolean                     @default(false)
  soBillCount              Int?
  adminBillCount           Int?
  soAmountWithoutGST       Decimal?                    @db.Decimal(14, 2)
  soAmountWithGST          Decimal?                    @db.Decimal(14, 2)
  adminAmountWithoutGST    Decimal?                    @db.Decimal(14, 2)
  adminAmountWithGST       Decimal?                    @db.Decimal(14, 2)
  bookingAmount            Decimal?                    @db.Decimal(14, 2)
  bookingBillNumber        Int?
  billsLockedAt            DateTime?
  segmentNumber            Int                         @default(1)
  adminBookingSchemeCount  Int?
  bills                    DealerSchemeBill[]
  instances                DealerSchemeInstance[]
  dealer                   Dealer                      @relation(fields: [dealerId], references: [id])
  enrolledBy               User?                       @relation("EnrolledSchemePlans", fields: [enrolledById], references: [id])
  rmActedBy                User?                       @relation("RmActedSchemePlans", fields: [rmActedById], references: [id])
  salesOfficer             User                        @relation("OfficerSchemePlans", fields: [salesOfficerId], references: [id])
  scheme                   Scheme                      @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  selectedOption           SchemeOption?               @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)
  conversionExtensions     SchemeConversionExtension[]
  payments                 SchemePayment[]
  quantitySplitAsFuture    SchemePlanQuantitySplit?    @relation("SchemePlanQuantitySplitFuture")
  quantitySplitAsSource    SchemePlanQuantitySplit?    @relation("SchemePlanQuantitySplitSource")

  @@unique([schemeId, dealerId, segmentNumber])
  @@index([schemeId, dealerId])
  @@index([schemeId])
  @@index([dealerId])
  @@index([salesOfficerId])
  @@index([planningStatus])
  @@index([enrollmentStatus])
  @@index([planStatus])
  @@index([schemeStatus])
  @@index([selectedOptionId])
}

/// Immutable audit record for reducing an approved plan at conversion. The source plan keeps the quantity
/// proceeding now; a FUTURE_DRAFT split links the remaining quantity to another ordinary DealerSchemePlan.
model SchemePlanQuantitySplit {
  id                 String                         @id @default(cuid())
  sourcePlanId       String                         @unique
  futurePlanId       String?                        @unique
  originalQuantity   Int
  proceedingQuantity Int
  remainingQuantity  Int
  disposition        SchemePlanRemainderDisposition
  createdById        String
  createdAt          DateTime                       @default(now())
  createdBy          User                           @relation("SchemePlanQuantitySplitCreatedBy", fields: [createdById], references: [id])
  futurePlan         DealerSchemePlan?              @relation("SchemePlanQuantitySplitFuture", fields: [futurePlanId], references: [id])
  sourcePlan         DealerSchemePlan               @relation("SchemePlanQuantitySplitSource", fields: [sourcePlanId], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([disposition])
}

/// One Conversion Date Extension event for a dealer plan. Immutable history — the source of truth for how
/// many extensions were made and how many cumulative days were consumed against the ORIGINAL date.
model SchemeConversionExtension {
  id                     String           @id @default(cuid())
  planId                 String
  extensionNumber        Int
  originalConversionDate DateTime
  previousConversionDate DateTime
  newConversionDate      DateTime
  daysAdded              Int
  extendedById           String
  createdAt              DateTime         @default(now())
  extendedBy             User             @relation("ConversionExtendedBy", fields: [extendedById], references: [id])
  plan                   DealerSchemePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, extensionNumber])
  @@index([planId])
}

/// One scheme instance for a dealer plan. A plan with numberOfSchemes = N has N instances (1..N); each
/// instance is one occurrence of the scheme and owns its OWN billing dates + installment schedule. This
/// makes multi-scheme dealers first-class without duplicating DealerSchemePlan rows.
model DealerSchemeInstance {
  id                    String                    @id @default(cuid())
  dealerSchemePlanId    String
  instanceNumber        Int
  soBillingDate         DateTime?
  adminBillingDate      DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  billMode              Boolean                   @default(false)
  soBillCount           Int?
  adminBillCount        Int?
  adminAmountWithoutGST Decimal?                  @db.Decimal(14, 2)
  adminAmountWithGST    Decimal?                  @db.Decimal(14, 2)
  bookingAmount         Decimal?                  @db.Decimal(14, 2)
  bookingBillNumber     Int?
  billsLockedAt         DateTime?
  bills                 DealerSchemeBill[]
  installments          DealerSchemeInstallment[]
  dealerSchemePlan      DealerSchemePlan          @relation(fields: [dealerSchemePlanId], references: [id], onDelete: Cascade)

  @@unique([dealerSchemePlanId, instanceNumber])
  @@index([dealerSchemePlanId])
}

/// One declared bill of a scheme instance. SO dates are references; Admin data drives its locked schedule.
model DealerSchemeBill {
  id                                                                                  String                    @id @default(cuid())
  instanceId                                                                          String?
  partNumber                                                                          Int
  soBillDate                                                                          DateTime?
  adminBillDate                                                                       DateTime?
  amountWithoutGST                                                                    Decimal?                  @db.Decimal(14, 2)
  amountWithGST                                                                       Decimal?                  @db.Decimal(14, 2)
  verifiedAt                                                                          DateTime?
  verifiedById                                                                        String?
  createdAt                                                                           DateTime                  @default(now())
  updatedAt                                                                           DateTime                  @updatedAt
  planId                                                                              String?
  soAmountWithoutGST                                                                  Decimal?                  @db.Decimal(14, 2)
  soAmountWithGST                                                                     Decimal?                  @db.Decimal(14, 2)
  instance                                                                            DealerSchemeInstance?     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  plan                                                                                DealerSchemePlan?         @relation(fields: [planId], references: [id], onDelete: Cascade)
  billProducts                                                                        DealerSchemeBillProduct[]
  installments                                                                        DealerSchemeInstallment[]
  DealerSchemeInstallment_DealerSchemeInstallment_billId_instanceIdToDealerSchemeBill DealerSchemeInstallment[] @relation("DealerSchemeInstallment_billId_instanceIdToDealerSchemeBill")

  @@unique([planId, partNumber])
  @@unique([instanceId, partNumber])
  @@unique([id, instanceId])
}

/// Per-product, per-bill quantities for product-rate billing (Product Quantity Based and Options Value Based).
/// One row per (bill, product):
/// the SO's planned/proposed quantity and the Admin's actual/verified quantity, with the product RATE
/// SNAPSHOTTED at conversion (so later Scheme Master edits never change a historical bill). Bill amounts are
/// derived from these (Admin actual qty × snapshot rate = verified bill amount = installment base). The
/// bill's own amount fields remain the authoritative installment base; this table is the auditable source.
/// `productId` is stored plain (no FK relation) to avoid touching the Product model; integrity is enforced
/// at the application layer. Cascades with its bill.
model DealerSchemeBillProduct {
  id             String           @id @default(cuid())
  billId         String
  productId      String
  soQty          Decimal?         @db.Decimal(14, 3)
  adminQty       Decimal?         @db.Decimal(14, 3)
  rateWithoutGST Decimal          @db.Decimal(14, 2)
  rateWithGST    Decimal          @db.Decimal(14, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  bill           DealerSchemeBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, productId])
  @@index([billId])
  @@index([productId])
}

/// Bill-linked schedules are immutable after creation. A null billId preserves legacy instance schedules.
/// Received amounts remain rollups of SchemePaymentAllocation records.
model DealerSchemeInstallment {
  id                                                                           String                    @id @default(cuid())
  installmentNumber                                                            Int
  plannedAmount                                                                Decimal                   @db.Decimal(14, 2)
  plannedDate                                                                  DateTime?
  receivedAmount                                                               Decimal?                  @db.Decimal(14, 2)
  receivedDate                                                                 DateTime?
  status                                                                       String                    @default("PENDING")
  createdById                                                                  String?
  updatedById                                                                  String?
  createdAt                                                                    DateTime                  @default(now())
  updatedAt                                                                    DateTime                  @updatedAt
  instanceId                                                                   String?
  billId                                                                       String?
  bill                                                                         DealerSchemeBill?         @relation(fields: [billId], references: [id], onDelete: Restrict)
  DealerSchemeBill_DealerSchemeInstallment_billId_instanceIdToDealerSchemeBill DealerSchemeBill?         @relation("DealerSchemeInstallment_billId_instanceIdToDealerSchemeBill", fields: [billId, instanceId], references: [id, instanceId], onDelete: Restrict)
  instance                                                                     DealerSchemeInstance?     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  paymentAllocations                                                           SchemePaymentAllocation[]

  @@unique([billId, installmentNumber])
  @@index([instanceId])
}

/// A single actual money-received transaction for an enrolled dealer's scheme plan (Payment Management).
/// The payment is the SOURCE OF TRUTH for money received; `receivedDate` is when the dealer paid and
/// `recordedAt` is the system entry time. Its amount is allocated sequentially, from the earliest
/// outstanding installment, into `SchemePaymentAllocation` rows within ONE transaction. The installment's
/// own receivedAmount/receivedDate are maintained as a denormalised rollup of these allocations so the
/// Enrolled Scheme view and Follow-up recovery figures keep reading them unchanged. Payments are never
/// overwritten — every transaction stays permanently traceable.
model SchemePayment {
  id           String                    @id @default(cuid())
  planId       String
  amount       Decimal                   @db.Decimal(14, 2)
  receivedDate DateTime
  recordedAt   DateTime                  @default(now())
  createdById  String
  note         String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  createdBy    User                      @relation("SchemePaymentCreatedBy", fields: [createdById], references: [id])
  plan         DealerSchemePlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  allocations  SchemePaymentAllocation[]

  @@index([planId])
  @@index([recordedAt])
  @@index([receivedDate])
}

/// Where one payment's money went: an amount allocated to a specific installment. Preserves the
/// transaction-level allocation (a single payment may split across several installments) so the history
/// can always explain exactly which installment(s) each payment settled.
model SchemePaymentAllocation {
  id            String                  @id @default(cuid())
  paymentId     String
  installmentId String
  amount        Decimal                 @db.Decimal(14, 2)
  createdAt     DateTime                @default(now())
  installment   DealerSchemeInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  payment       SchemePayment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([installmentId])
}

/// A Scheme can be available in multiple existing State/UserGroup records.
model SchemeState {
  schemeId String
  groupId  String
  group    UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scheme   Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@id([schemeId, groupId])
  @@index([groupId])
}

/// One required product for a Scheme's Achievement Requirement (shared by every enrolled dealer — the
/// requirement belongs to the Scheme, never to a dealer plan). PRODUCT_BASED uses `requiredQty`;
/// VALUE_BASED + INDIVIDUAL uses `requiredValue`; VALUE_BASED + COMBINED lists the participating products
/// here (both null) with the single target on Scheme.combinedRequiredValue.
model SchemeRequirementProduct {
  id             String   @id @default(cuid())
  schemeId       String
  productId      String
  requiredQty    Decimal? @db.Decimal(14, 3)
  requiredValue  Decimal? @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  rateWithoutGST Decimal? @db.Decimal(14, 2)
  rateWithGST    Decimal? @db.Decimal(14, 2)
  product        Product  @relation(fields: [productId], references: [id])
  scheme         Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, productId])
  @@index([schemeId])
  @@index([productId])
}

/// One predefined option of a MULTIPLE_OPTIONS scheme. A dealer commits to exactly one. The target is a
/// single combined total across the scheme's eligible product pool (qty OR value by the scheme's
/// optionAchievementType). Each option carries its OWN commercial value pair. Options are never hard-deleted
/// once selected by a dealer — they are discontinued (isActive=false) to preserve historical integrity.
model SchemeOption {
  id              String             @id @default(cuid())
  schemeId        String
  label           String?
  targetQty       Decimal?           @db.Decimal(14, 3)
  targetValue     Decimal?           @db.Decimal(14, 2)
  valueWithoutGST Decimal            @db.Decimal(14, 2)
  valueWithGST    Decimal            @db.Decimal(14, 2)
  sortOrder       Int                @default(0)
  isActive        Boolean            @default(true)
  discontinuedAt  DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  bookingAmount   Decimal?           @db.Decimal(14, 2)
  dealerPlans     DealerSchemePlan[]
  scheme          Scheme             @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([schemeId])
}

/// The eligible product pool of a MULTIPLE_OPTIONS scheme. These products collectively contribute toward the
/// selected option's single total target — they carry NO per-product requirement (contrast
/// SchemeRequirementProduct, used only by FIXED schemes). Kept in a separate table for clear semantics.
model SchemeEligibleProduct {
  id             String   @id @default(cuid())
  schemeId       String
  productId      String
  createdAt      DateTime @default(now())
  rateWithoutGST Decimal? @db.Decimal(14, 2)
  rateWithGST    Decimal? @db.Decimal(14, 2)
  product        Product  @relation(fields: [productId], references: [id])
  scheme         Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, productId])
  @@index([schemeId])
  @@index([productId])
}

/// One Scheme Upload event: a date-range batch that may target one OR several schemes from a single
/// uploaded file. Purely a scheme-tracking layer — it never writes MonthlyEntry or any normal Sales
/// Planning actual. Superseded (not deleted) when a covered scheme+range is re-uploaded, for auditability.
model SchemeUploadBatch {
  id           String                    @id @default(cuid())
  uploadedById String
  fileName     String
  startDate    DateTime
  endDate      DateTime
  summary      String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  uploadedBy   User                      @relation("SchemeUploadBatches", fields: [uploadedById], references: [id])
  scopes       SchemeUploadBatchScheme[]

  @@index([createdAt])
}

/// The per-(scheme + date range) scope of an upload batch — the replacement/idempotency key. Re-uploading
/// a scheme+range supersedes ONLY its own scope row + SchemeSale rows; other schemes in the same range or
/// the same file are never affected. Also carries the analysis summary counts for history.
model SchemeUploadBatchScheme {
  id              String             @id @default(cuid())
  batchId         String
  schemeId        String
  startDate       DateTime
  endDate         DateTime
  status          SchemeUploadStatus @default(ACTIVE)
  enrolledChecked Int                @default(0)
  matchedQty      Decimal?           @db.Decimal(14, 3)
  matchedValue    Decimal?           @db.Decimal(14, 2)
  supersededAt    DateTime?
  createdAt       DateTime           @default(now())
  sales           SchemeSale[]
  batch           SchemeUploadBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  scheme          Scheme             @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([schemeId, startDate, endDate, status])
  @@index([batchId])
}

/// One tracked scheme-achievement fact — an enrolled dealer's applicable sale of a required product within
/// one upload scope. It hangs off exactly ONE `SchemeUploadBatchScheme` (the scope), which is the single
/// source of truth for its batch + scheme + tracking date range + ACTIVE/SUPERSEDED state — so an invalid
/// batch↔scheme combination is structurally impossible, and the fact carries NO per-row sale date (Decision
/// A: the scope's start/end IS the authoritative period). Because each scheme has its own scope+sales, the
/// SAME underlying sale contributes independently to every scheme (never globally consumed). Achievement
/// reads only sales whose scope.status = ACTIVE; superseded scopes' sales are retained purely for audit.
/// NEVER linked to MonthlyEntry or any normal Sales Planning actual.
model SchemeSale {
  id             String                  @id @default(cuid())
  scopeId        String
  dealerId       String
  productId      String
  qty            Decimal                 @db.Decimal(14, 3)
  value          Decimal                 @db.Decimal(14, 2)
  rawDealerName  String
  rawProductName String
  createdAt      DateTime                @default(now())
  dealer         Dealer                  @relation(fields: [dealerId], references: [id])
  product        Product                 @relation(fields: [productId], references: [id])
  scope          SchemeUploadBatchScheme @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@index([scopeId])
  @@index([scopeId, dealerId, productId])
  @@index([dealerId])
  @@index([productId])
}

/// Group-wise Product Catalogue: which Master Products are available in a group, at what group price,
/// and whether they are active for that group's planning. The Master Product remains the single product
/// identity (no product duplication); this is a per-(group, product) overlay. Plans SNAPSHOT the price
/// they use (PlanLine.rateSnapshot) at creation, so changing a group price never alters historical plans.
model GroupProductCatalogue {
  id             String    @id @default(cuid())
  groupId        String
  productId      String
  price          Decimal   @db.Decimal(12, 2)
  isActive       Boolean   @default(true)
  priceIsInitial Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  isClearance    Boolean   @default(false)
  clearanceQty   Int?
  group          UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id])

  @@unique([groupId, productId])
  @@index([groupId])
  @@index([productId])
}

/// Product Category. A category owns an NBV% (stored as a fraction, e.g. 0.35 = 35%); every Product whose
/// nbvPercent matches adopts it automatically — there is NO manual product↔category mapping. `notation`
/// is a short code (e.g. "P") and `color` a hex string, both used only for the display badge/filter.
model Category {
  id         String    @id @default(cuid())
  name       String    @unique
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  nbvPercent Decimal?  @unique @db.Decimal(6, 4)
  notation   String?
  color      String?
  products   Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

/// Product master (replaces the Excel PRICELIST). Rate & NBV% are read-only to
/// SO/RM and flow into planning by product identity — never by row position.
model Product {
  id                     String                     @id @default(cuid())
  name                   String                     @unique
  technicalName          String?
  rate                   Decimal                    @db.Decimal(12, 2)
  nbvPercent             Decimal                    @db.Decimal(6, 4)
  categoryId             String?
  brandId                String?
  isActive               Boolean                    @default(true)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  canonicalName          String?
  mergedIntoId           String?
  mergedAt               DateTime?
  mergedById             String?
  groupCatalogues        GroupProductCatalogue[]
  planLines              PlanLine[]
  brand                  Brand?                     @relation(fields: [brandId], references: [id])
  category               Category?                  @relation(fields: [categoryId], references: [id])
  mergedInto             Product?                   @relation("ProductMerge", fields: [mergedIntoId], references: [id])
  mergedFrom             Product[]                  @relation("ProductMerge")
  schemeEligibleProducts SchemeEligibleProduct[]
  schemeRequirements     SchemeRequirementProduct[]
  schemeSales            SchemeSale[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([mergedIntoId])
}

/// Auditable, reversible record of a Product Merge / Consolidation (one row per merge). Additive only — it
/// never affects planning/catalogue data directly; it records the operation and enables safe reversal.
model ProductMerge {
  id                 String    @id @default(cuid())
  sourceProductId    String
  survivingProductId String
  performedById      String
  catalogueImpact    String?
  note               String?
  reversedAt         DateTime?
  reversedById       String?
  createdAt          DateTime  @default(now())

  @@index([sourceProductId])
  @@index([survivingProductId])
  @@index([createdAt])
}

/// Dealer master. Ownership over time is expressed via DealerAssignment.
model Dealer {
  id                        String                @id @default(cuid())
  name                      String
  town                      String?
  isActive                  Boolean               @default(true)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  mobile                    String?
  village                   String?
  tehsil                    String?
  district                  String?
  address                   String?
  status                    String                @default("ACTIVE")
  createdByUserId           String?
  createdFrom               String?
  deletedAt                 DateTime?
  cnRequests                CnRequest[]
  dailyWorkEntries          DailyWorkEntry[]
  aliases                   DealerAlias[]
  assignments               DealerAssignment[]
  schemePlans               DealerSchemePlan[]
  tagAssignments            DealerTagAssignment[]
  tagRequests               DealerTagRequest[]
  lastPaymentReceipts       LastPaymentReceipt[]
  planDealers               PlanDealer[]
  recoveryPlanDealers       RecoveryPlanDealer[]
  schemeSales               SchemeSale[]
  marketMapping             DealerMarketMapping?
  appointedFromMonthlyPlans PartyMonthlyPlan[]    @relation("PartyMonthlyAppointedDealer")
  marketEdits               TerritoryMarketEdit[]

  @@index([isActive])
  @@index([status])
}

/// Credit Note (CN) Request raised by a Sales Officer for one of their dealers. Workflow:
/// SUBMITTED → ACCEPTED_NOT_POSTED → POSTED_IN_LEDGER, or SUBMITTED → REJECTED.
/// Legacy ACCEPTED / APPROVED rows remain unchanged and are treated as already posted by the application.
model CnRequest {
  id                          String           @id @default(cuid())
  officerId                   String
  dealerId                    String
  cnType                      String
  amount                      Decimal?         @db.Decimal(14, 2)
  paymentStatus               String?
  status                      String           @default("SUBMITTED")
  remarks                     String?
  actedByRmId                 String?
  actedByAdminId              String?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt
  details                     String?
  acceptedAt                  DateTime?
  rejectedAt                  DateTime?
  postedAt                    DateTime?
  rejectionReason             String?
  rejectionReasonDetails      String?
  acceptanceReason            String?
  acceptanceReasonDetails     String?
  cnWorkingDocument           String?
  cnWorkingFileName           String?
  cnWorkingMimeType           String?
  cnWorkingFileSize           Int?
  cnWorkingUploadedById       String?
  cnWorkingUploadedAt         DateTime?
  taskDate                    DateTime?        @db.Date
  cnExpiryDays                Int?
  postedAmount                Decimal?         @db.Decimal(14, 2)
  paymentOriginalAmount       Decimal?         @db.Decimal(14, 2)
  paymentOutstandingAmount    Decimal?         @db.Decimal(14, 2)
  paymentTrackingMode         String?
  paymentVerified             Boolean          @default(false)
  legacyDailyWorkEntryId      String?
  legacyDailyWorkContribution Decimal?         @db.Decimal(14, 2)
  legacyDailyWorkConfirmed    Boolean          @default(false)
  finalCnDocument             String?
  finalCnFileName             String?
  finalCnMimeType             String?
  finalCnFileSize             Int?
  finalCnUploadedById         String?
  finalCnUploadedAt           DateTime?
  paymentEvents               CnPaymentEvent[]
  dealer                      Dealer           @relation(fields: [dealerId], references: [id])
  legacyDailyWorkEntry        DailyWorkEntry?  @relation("LegacyCnTaskDailyWorkEntry", fields: [legacyDailyWorkEntryId], references: [id])
  officer                     User             @relation("OfficerCnRequests", fields: [officerId], references: [id])

  @@index([officerId])
  @@index([status])
  @@index([officerId, taskDate])
  @@index([legacyDailyWorkEntryId])
}

/// Immutable CN payment decisions. A row may also own the one Recovery follow-up task produced by that
/// decision. This keeps repeated CN follow-ups in the existing Daily Work Recovery UI while giving every
/// task a stable id, amount, date and lifecycle. Historical CnRequest.taskDate rows remain untouched.
model CnPaymentEvent {
  id                    String          @id @default(cuid())
  cnRequestId           String
  status                String
  amountPaid            Decimal?        @db.Decimal(14, 2)
  eventDate             DateTime        @db.Date
  outstandingBefore     Decimal         @db.Decimal(14, 2)
  outstandingAfter      Decimal         @db.Decimal(14, 2)
  taskAmount            Decimal?        @db.Decimal(14, 2)
  taskDate              DateTime?       @db.Date
  taskStatus            String?
  taskCompletedAt       DateTime?
  source                String
  requestKey            String          @unique
  recordedById          String
  createdAt             DateTime        @default(now())
  taskRescheduled       Boolean         @default(false)
  dailyWorkEntryId      String?
  dailyWorkContribution Decimal?        @db.Decimal(14, 2)
  dailyWorkConfirmed    Boolean         @default(false)
  /// Optional title captured at the payment action, never inferred for historical events.
  actorDesignation      String?
  cnRequest             CnRequest       @relation(fields: [cnRequestId], references: [id])
  dailyWorkEntry        DailyWorkEntry? @relation("CnPaymentEventDailyWorkEntry", fields: [dailyWorkEntryId], references: [id])
  recordedBy            User            @relation("CnPaymentEventRecordedBy", fields: [recordedById], references: [id])

  @@index([cnRequestId, createdAt])
  @@index([cnRequestId, taskStatus])
  @@index([taskDate])
  @@index([dailyWorkEntryId])
}

/// Party Planning (Phase 1) — a minimal Sales Officer planning record with a Draft → Submit → Admin
/// Approval workflow. One row per planned party appointment; there is intentionally NO Party Master, no
/// contacts/visit-report/follow-up. `status` mirrors the app's plain-string convention (see CnRequest):
/// DRAFT → PENDING_APPROVAL → APPROVED / REJECTED. Rejected plans become owner-editable again (the app's
/// Returned/Rejected → editable convention). partyName/marketName/appointmentDate are nullable so a Draft
/// may be incomplete; Submit enforces all three (server-side). appointmentDate is a pure business date
/// (@db.Date) to avoid any timezone shift. Phase 2 will connect approved plans to the calendar.
model PartyPlan {
  id              String    @id @default(cuid())
  salesOfficerId  String
  partyName       String?
  marketName      String?
  appointmentDate DateTime? @db.Date
  status          String    @default("DRAFT")
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  salesOfficer    User      @relation("PartyPlanOfficer", fields: [salesOfficerId], references: [id])

  @@index([salesOfficerId])
  @@index([status])
}

/// Daily Work Template — a Sales Officer's daily execution entry for ONE row in ONE section
/// (SALES | RECOVERY | APPOINTMENT | SCHEME_CONVERSION) on ONE business date. Stores ONLY daily-execution
/// data that does not already exist anywhere else: the officer-entered Today's Plan, the manual actual/result
/// entered after submission, the Sales type, and (for Scheme Conversion) a reference to an existing planned
/// Scheme. It deliberately does NOT duplicate any source of truth — Monthly Sales Plan / actual sales come
/// live from MonthlyEntry, Monthly Recovery from RecoveryPlanDealer, planned scheme units + converted units
/// from DealerSchemePlan. Pending and the combined-summary row are always DERIVED at read time — never stored.
///
/// Row identity: `rowKey` is the per-section natural key (SALES/RECOVERY → the dealerId; SCHEME_CONVERSION →
/// "dealerId:schemeId" so a dealer may appear once per planned scheme; APPOINTMENT → a client row id, since
/// its dealer/market are free text). The unique (officerId, workDate, batchId, section, rowKey) enforces
/// "no duplicate rows" inside one batch while allowing the same row identity in later batches.
///
/// Lifecycle: DRAFT → PLAN_SUBMITTED → FINALIZED. Legacy SUBMITTED rows are retained for compatibility.
/// Post-submit fields (Today's Sales/Recovery `todaysActual`; Appointment/Achievability `resultStatus`) are
/// entered only on the exact frozen entry. `workDate` is a pure business date (@db.Date) — no timezone shift.
model DailyWorkEntry {
  id                   String           @id @default(cuid())
  officerId            String
  dealerId             String?
  workDate             DateTime         @db.Date
  section              String
  todaysPlan           Decimal?         @db.Decimal(14, 2)
  todaysActual         Decimal?         @db.Decimal(14, 2)
  entryType            String           @default("REGULAR")
  schemeId             String?
  status               String           @default("DRAFT")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  rowKey               String           @default("")
  typedDealerName      String?
  marketName           String?
  resultStatus         String?
  dealerVisits         Int?
  newPartyVisits       Int?
  others               String?
  noPlanSections       String?
  selfRating           Int?
  batchId              String           @default("")
  actualDealerVisits   Int?
  actualNewPartyVisits Int?
  planSubmittedAt      DateTime?
  paymentMode          String?
  cnPaymentTasks       CnPaymentEvent[] @relation("CnPaymentEventDailyWorkEntry")
  legacyCnTasks        CnRequest[]      @relation("LegacyCnTaskDailyWorkEntry")
  dealer               Dealer?          @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  officer              User             @relation("DailyWorkOfficer", fields: [officerId], references: [id])
  scheme               Scheme?          @relation(fields: [schemeId], references: [id])

  @@unique([officerId, workDate, batchId, section, rowKey])
  @@index([officerId])
  @@index([dealerId])
  @@index([schemeId])
  @@index([workDate])
  @@index([batchId])
}

/// One authoritative lifecycle record per officer and business date. Planning batches remain in DailyWorkEntry;
/// this row identifies the current editable batch and owns final Daily Report submission + Self Rating.
model DailyWorkDay {
  id             String    @id @default(cuid())
  officerId      String
  workDate       DateTime  @db.Date
  currentBatchId String
  status         String    @default("OPEN")
  selfRating     Int?
  finalizedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  officer        User      @relation("DailyWorkDayOfficer", fields: [officerId], references: [id])

  @@unique([officerId, workDate])
  @@index([officerId])
  @@index([workDate])
  @@index([status])
}

/// A Regional Manager's IMMUTABLE daily review of a Sales Officer's submitted Daily Work (Phase 2). A Daily Work
/// "submission" is identified by (officerId, workDate) — the row-based model has no single submission id — so the
/// review is keyed the same way. Exactly ONE review may exist per (officerId, workDate): the @@unique both blocks
/// duplicate/concurrent creation at the DB level and makes the review immutable (the service only ever inserts,
/// never updates or deletes). `rating` is an integer 1–10, validated server-side.
model DailyWorkReview {
  id         String   @id @default(cuid())
  officerId  String
  workDate   DateTime @db.Date
  reviewerId String
  rating     Int
  reviewedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  officer    User     @relation("DailyWorkReviewOfficer", fields: [officerId], references: [id])
  reviewer   User     @relation("DailyWorkReviewReviewer", fields: [reviewerId], references: [id])

  @@unique([officerId, workDate])
  @@index([reviewerId])
  @@index([workDate])
}

/// Performance attendance for one Sales Officer on one business date (Phase 4). Attendance is INDEPENDENT of
/// Daily Work submission (Present + Not Submitted is valid). The absence of a row means Present (the default), so
/// historical dates need no back-fill and only explicit Admin overrides are persisted. Only a Super Admin writes.
model DailyWorkAttendance {
  id        String   @id @default(cuid())
  officerId String
  workDate  DateTime @db.Date
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  officer   User     @relation("DailyWorkAttendanceOfficer", fields: [officerId], references: [id])

  @@unique([officerId, workDate])
  @@index([workDate])
}

/// A season (e.g. Kharif 2026) with up to six ordered, named months.
model Season {
  id                 String                  @id @default(cuid())
  name               String
  year               Int
  status             SeasonStatus            @default(OPEN)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  endMonth           Int?
  endYear            Int?
  monthlyMode        String                  @default("PACK_SIZE")
  seasonalMode       String                  @default("PACK_SIZE")
  startMonth         Int?
  startYear          Int?
  extensionRequests  MonthExtensionRequest[]
  recoveryPlans      RecoveryPlan[]
  months             SeasonMonth[]
  plans              SeasonPlan[]
  seasonalPlans      SeasonalPlan[]
  partyMonthlyPlans  PartyMonthlyPlan[]
  seasonalSheets     SeasonalPlanSheet[]
  partyMonthlySheets PartyMonthlySheet[]

  @@unique([name, year])
}

model SeasonMonth {
  id                 String              @id @default(cuid())
  seasonId           String
  name               String
  order              Int
  status             String              @default("OPEN")
  calendarMonth      Int?
  calendarYear       Int?
  monthlyEntries     MonthlyEntry[]
  monthlyPlans       MonthlyPlan[]
  partyMonthlyPlans  PartyMonthlyPlan[]
  partyMonthlySheets PartyMonthlySheet[]
  recoveryPlans      RecoveryPlan[]
  season             Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, order])
  @@unique([seasonId, calendarYear, calendarMonth])
  @@index([seasonId])
}

model Announcement {
  id           String                   @id @default(cuid())
  title        String
  body         String
  audienceRole Role?
  targetUserId String?
  activeFrom   DateTime                 @default(now())
  activeTo     DateTime?
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  targetUser   User?                    @relation("AnnouncementTargetUser", fields: [targetUserId], references: [id])
  reads        AnnouncementReadStatus[]

  @@index([isActive])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Time-aware Dealer→Sales Officer assignment (explicit from–to ranges).
/// A dealer must not have overlapping active ranges (enforced in the service layer).
model DealerAssignment {
  id            String    @id @default(cuid())
  dealerId      String
  officerId     String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  dealer        Dealer    @relation(fields: [dealerId], references: [id])
  officer       User      @relation("OfficerDealers", fields: [officerId], references: [id])

  @@index([dealerId])
  @@index([officerId])
  @@index([effectiveFrom])
}

/// Time-aware Sales Officer→Regional Manager assignment (explicit from–to ranges).
/// Absence of a current row = the officer reports directly to the Super Admin.
model RmAssignment {
  id            String    @id @default(cuid())
  officerId     String
  managerId     String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  manager       User      @relation("ManagerRm", fields: [managerId], references: [id])
  officer       User      @relation("OfficerRm", fields: [officerId], references: [id])

  @@index([officerId])
  @@index([managerId])
  @@index([effectiveFrom])
}

/// Immutable audit trail of create/update/deactivate actions.
model AuditLog {
  id               String   @id @default(cuid())
  userId           String
  action           String
  entity           String
  entityId         String?
  summary          String?
  createdAt        DateTime @default(now())
  /// Title at the time of the action; null for legacy records (never backfilled).
  actorDesignation String?
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

/// A personal calendar note pinned to a date by its owner. This is the ONLY calendar data that is stored:
/// CONVERSION calendar events are PROJECTED at read time from DealerSchemePlan (never duplicated here).
/// `date` is a date-only value (stored at midnight), matching how conversion dates are handled elsewhere.
model CalendarNote {
  id        String   @id @default(cuid())
  ownerId   String
  date      DateTime
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation("CalendarNoteOwner", fields: [ownerId], references: [id])

  @@index([ownerId, date])
  @@index([date])
}

/// A Calendar entry created from the date dialog: TASK (a Daily Work task), MEETING, REMINDER or OTHER. The owner is the
/// creator/responsible user (always the caller). CalendarNote above is untouched (existing notes keep working).
/// A TASK is the SOURCE of a Daily Work row: when due it is materialized ONCE into the owner's current editable Daily Work
/// batch (`dailyWorkEntryId` + `materializedAt` are set atomically with the claim, so it can never duplicate) and shows
/// there with Task Type "Calendar". Task payload columns mirror the Daily Work entry they become.
model CalendarEntry {
  id                    String    @id @default(cuid())
  ownerId               String
  date                  DateTime  @db.Date
  kind                  String
  text                  String?
  taskSection           String?
  dealerId              String?
  amount                Decimal?  @db.Decimal(14, 2)
  entryType             String?
  schemeId              String?
  paymentMode           String?
  typedDealerName       String?
  marketName            String?
  dealerVisits          Int?
  newPartyVisits        Int?
  dailyWorkEntryId      String?
  dailyWorkContribution Decimal?  @db.Decimal(14, 2)
  materializedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  owner                 User      @relation("CalendarEntryOwner", fields: [ownerId], references: [id])

  @@index([ownerId, date])
  @@index([date])
  @@index([dailyWorkEntryId])
}

/// Field-level history of Super-Admin corrections to APPROVED plans (Admin Override / Edit Mode).
/// One row per changed INPUT field. Denormalised (dealer/product names captured at edit time) and
/// FK-free so the trail survives even if a referenced record is later removed. Additive only — it
/// records history and never affects planning data or the approval workflow.
model AdminEditAudit {
  id            String   @id @default(cuid())
  adminId       String
  planType      String
  planId        String
  version       Int?
  seasonId      String?
  seasonMonthId String?
  dealerId      String
  dealerName    String
  productId     String?
  productName   String?
  fieldName     String
  oldValue      Decimal? @db.Decimal(14, 4)
  newValue      Decimal? @db.Decimal(14, 4)
  difference    Decimal? @db.Decimal(14, 4)
  reason        String
  createdAt     DateTime @default(now())

  @@index([planId])
  @@index([dealerId])
  @@index([productId])
  @@index([seasonId])
  @@index([seasonMonthId])
  @@index([adminId])
  @@index([createdAt])
}

/// The approvable unit: one Season Plan per officer per season, per version.
/// A revision creates a new version (v2, v3…) copied from the last approved one;
/// prior versions remain immutable in history.
model SeasonPlan {
  id                String           @id @default(cuid())
  seasonId          String
  officerId         String
  version           Int              @default(1)
  status            PlanStatus       @default(DRAFT)
  isActiveVersion   Boolean          @default(false)
  supersedesId      String?
  revisionRequested Boolean          @default(false)
  revisionReason    String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  lastSavedAt       DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  description       String?
  planningType      String           @default("SEASONAL")
  source            String           @default("MANUAL")
  versionName       String?
  lifecycleState    String           @default("ACTIVE")
  closedAt          DateTime?
  deactivatedAt     DateTime?
  actions           ApprovalAction[]
  monthlyPlans      MonthlyPlan[]
  dealers           PlanDealer[]
  recoveryPlans     RecoveryPlan[]
  officer           User             @relation("OfficerPlans", fields: [officerId], references: [id])
  season            Season           @relation(fields: [seasonId], references: [id])

  @@unique([seasonId, officerId, planningType, version])
  @@index([officerId])
  @@index([seasonId])
  @@index([status])
  @@index([planningType])
  @@index([lifecycleState])
}

/// Company Onboarding run — the migration report (Section 41). Metadata only; the source
/// (workbook) is never stored. Downloadable + retained for audit / Import History.
model OnboardingRecord {
  id         String       @id @default(cuid())
  runById    String
  source     String       @default("EXCEL")
  sourceName String
  seasonId   String?
  officerId  String?
  status     ImportStatus @default(COMPLETED)
  report     String?
  createdAt  DateTime     @default(now())
  runBy      User         @relation("OnboardingRuns", fields: [runById], references: [id])

  @@index([createdAt])
}

/// Audit trail for the Seasonal Plan Import (metadata only; the workbook is never stored).
model SeasonPlanImportRecord {
  id           String       @id @default(cuid())
  importedById String
  seasonId     String
  officerId    String
  workbookName String
  dealerCount  Int          @default(0)
  productRows  Int          @default(0)
  status       ImportStatus @default(COMPLETED)
  summary      String?
  createdAt    DateTime     @default(now())
  importedBy   User         @relation("PlanImports", fields: [importedById], references: [id])

  @@index([createdAt])
}

/// A dealer grouping inside a Season Plan (dealer-first structure).
model PlanDealer {
  id              String     @id @default(cuid())
  seasonPlanId    String
  dealerId        String
  noPlan          Boolean    @default(false)
  noPlanReason    String?
  fromMonthlyPlan Boolean    @default(false)
  dealer          Dealer     @relation(fields: [dealerId], references: [id])
  seasonPlan      SeasonPlan @relation(fields: [seasonPlanId], references: [id], onDelete: Cascade)
  lines           PlanLine[]

  @@unique([seasonPlanId, dealerId])
  @@index([seasonPlanId])
  @@index([dealerId])
}

/// One product row within a dealer's plan. Quantities are entered per pack size
/// (see PlanLinePack); rate/NBV% are snapshotted at approval so approved figures
/// never change.
model PlanLine {
  id                 String         @id @default(cuid())
  planDealerId       String
  productId          String
  rateSnapshot       Decimal?       @db.Decimal(12, 2)
  nbvPercentSnapshot Decimal?       @db.Decimal(6, 4)
  inputMode          String?
  inputValue         Decimal?       @db.Decimal(14, 4)
  isAdditional       Boolean        @default(false)
  isAutoAdded        Boolean        @default(false)
  monthlyEntries     MonthlyEntry[]
  planDealer         PlanDealer     @relation(fields: [planDealerId], references: [id], onDelete: Cascade)
  product            Product        @relation(fields: [productId], references: [id])
  packs              PlanLinePack[]

  @@unique([planDealerId, productId])
  @@index([planDealerId])
  @@index([productId])
}

/// The quantity entered for one pack size on a plan line. One row per active pack
/// size; totals sum all rows (a deactivated pack size never drops stored quantity).
model PlanLinePack {
  id         String   @id @default(cuid())
  planLineId String
  packSizeId String
  quantity   Int      @default(0)
  packSize   PackSize @relation(fields: [packSizeId], references: [id])
  planLine   PlanLine @relation(fields: [planLineId], references: [id], onDelete: Cascade)

  @@unique([planLineId, packSizeId])
  @@index([planLineId])
  @@index([packSizeId])
}

/// Monthly plan quantity and actual sale quantity for an approved plan line, per
/// month. Entered within an approved Season Plan (no separate approval). Linked
/// directly to the approved PlanLine for strict referential integrity.
model MonthlyEntry {
  id            String      @id @default(cuid())
  planLineId    String
  seasonMonthId String
  planQty       Int         @default(0)
  saleQty       Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  inputMode     String?
  planValue     Decimal?    @db.Decimal(14, 4)
  saleValue     Decimal?    @db.Decimal(14, 4)
  planLine      PlanLine    @relation(fields: [planLineId], references: [id], onDelete: Cascade)
  seasonMonth   SeasonMonth @relation(fields: [seasonMonthId], references: [id])

  @@unique([planLineId, seasonMonthId])
  @@index([planLineId])
  @@index([seasonMonthId])
}

/// Immutable log of every workflow action on a Season Plan (status timeline).
model ApprovalAction {
  id                 String             @id @default(cuid())
  seasonPlanId       String?
  actorId            String
  action             ApprovalActionType
  fromStatus         PlanStatus?
  toStatus           PlanStatus?
  remarks            String?
  createdAt          DateTime           @default(now())
  monthlyPlanId      String?
  recoveryPlanId     String?
  dealerTagRequestId String?
  /// Optional title captured at the approval action; historical rows remain null.
  actorDesignation   String?
  actor              User               @relation(fields: [actorId], references: [id])
  dealerTagRequest   DealerTagRequest?  @relation(fields: [dealerTagRequestId], references: [id], onDelete: Restrict)
  monthlyPlan        MonthlyPlan?       @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  recoveryPlan       RecoveryPlan?      @relation(fields: [recoveryPlanId], references: [id], onDelete: Cascade)
  seasonPlan         SeasonPlan?        @relation(fields: [seasonPlanId], references: [id], onDelete: Cascade)

  @@index([seasonPlanId])
  @@index([monthlyPlanId])
  @@index([recoveryPlanId])
  @@index([dealerTagRequestId])
  @@index([actorId])
}

/// First-class Monthly Plan — the LIFECYCLE unit for planning exactly one month of an
/// APPROVED seasonal plan. It reuses the existing monthly data engine: the per-dealer/
/// per-line quantities live in `MonthlyEntry` (keyed planLine + seasonMonth), so there is
/// no duplicate MonthlyPlanDealer/MonthlyPlanLine store. This entity only tracks the
/// approval lifecycle (same PlanStatus + ApprovalAction workflow as the seasonal plan).
model MonthlyPlan {
  id                  String              @id @default(cuid())
  seasonPlanId        String
  seasonMonthId       String
  officerId           String
  status              PlanStatus          @default(DRAFT)
  submittedAt         DateTime?
  approvedAt          DateTime?
  lastSavedAt         DateTime            @default(now())
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  lifecycleState      String              @default("ACTIVE")
  closedAt            DateTime?
  deactivatedAt       DateTime?
  lifecycleFromParent Boolean             @default(false)
  actions             ApprovalAction[]
  officer             User                @relation("OfficerMonthlyPlans", fields: [officerId], references: [id])
  seasonMonth         SeasonMonth         @relation(fields: [seasonMonthId], references: [id])
  seasonPlan          SeasonPlan          @relation(fields: [seasonPlanId], references: [id], onDelete: Cascade)
  dealerStates        MonthlyPlanDealer[]

  @@unique([seasonPlanId, seasonMonthId])
  @@index([seasonPlanId])
  @@index([officerId])
  @@index([status])
  @@index([lifecycleState])
}

/// Per-dealer completion state WITHIN a Monthly Plan — the monthly analogue of
/// PlanDealer.noPlan. A dealer can be planned seasonally yet intentionally skipped ("No Plan")
/// for a specific month, so this state is keyed to the MonthlyPlan (not the seasonal
/// PlanDealer). "Completed"/"Remaining" stay derived from the stored monthly plan values; only
/// "No Plan" is persisted here.
model MonthlyPlanDealer {
  id            String      @id @default(cuid())
  monthlyPlanId String
  dealerId      String
  noPlan        Boolean     @default(false)
  noPlanReason  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  monthlyPlan   MonthlyPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)

  @@unique([monthlyPlanId, dealerId])
  @@index([monthlyPlanId])
}

/// A Sales Officer's request to add a future month to a Season. Nothing changes until an
/// admin approves; approval appends a SeasonMonth (OPEN) to the season and notifies the SO.
model MonthExtensionRequest {
  id            String    @id @default(cuid())
  seasonId      String
  requestedById String
  monthName     String
  monthOrder    Int
  status        String    @default("PENDING")
  decisionNote  String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  decidedBy     User?     @relation("ExtensionDecidedBy", fields: [decidedById], references: [id])
  requestedBy   User      @relation("ExtensionRequestedBy", fields: [requestedById], references: [id])
  season        Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId])
  @@index([status])
  @@index([createdAt])
}

/// Maps a Tally-exported dealer name to a system Dealer, so Sales Upload can resolve dealers
/// whose Tally spelling differs from the master. Checked BEFORE name matching. `tallyKey` is
/// tightKey(tallyName) and is unique, which enforces "Duplicate Dealer Alias" at the DB level.
model DealerAlias {
  id             String   @id @default(cuid())
  systemDealerId String
  tallyName      String
  tallyKey       String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  systemDealer   Dealer   @relation(fields: [systemDealerId], references: [id], onDelete: Cascade)

  @@index([systemDealerId])
}

/// Global marker definitions. Deactivation hides markers without deleting assignments or history.
model DealerTag {
  id          String                @id @default(cuid())
  name        String
  nameKey     String                @unique
  markerType  String
  marker      String
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  assignments DealerTagAssignment[]
  requests    DealerTagRequest[]
}

/// Only final approval/direct Admin actions change this state; pending revoke leaves it active.
model DealerTagAssignment {
  id        String    @id @default(cuid())
  dealerId  String
  tagId     String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  dealer    Dealer    @relation(fields: [dealerId], references: [id])
  tag       DealerTag @relation(fields: [tagId], references: [id])

  @@unique([dealerId, tagId])
  @@index([tagId, isActive])
}

/// Shares PlanStatus, ApprovalAction, the existing Approvals page, hierarchy and audit infrastructure.
model DealerTagRequest {
  id            String           @id @default(cuid())
  dealerId      String
  tagId         String
  requestedById String
  operation     String
  status        PlanStatus
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  actions       ApprovalAction[]
  dealer        Dealer           @relation(fields: [dealerId], references: [id])
  requestedBy   User             @relation(fields: [requestedById], references: [id])
  tag           DealerTag        @relation(fields: [tagId], references: [id])

  @@index([requestedById, status])
  @@index([dealerId, tagId])
}

/// Audit/history record for a Sales Upload (Tally actual-sales import). Metadata only — the
/// workbook is never stored. Actual quantities/values are written onto MonthlyEntry.saleQty /
/// saleValue (no duplicate per-row store).
model SalesUploadRun {
  id              String       @id @default(cuid())
  uploadedById    String
  workbookName    String
  seasonMonthId   String?
  targetMonthName String
  fromDate        DateTime?
  toDate          DateTime?
  dealersUpdated  Int          @default(0)
  productsUpdated Int          @default(0)
  rowsImported    Int          @default(0)
  unknownDealers  Int          @default(0)
  unknownProducts Int          @default(0)
  status          ImportStatus @default(COMPLETED)
  summary         String?
  createdAt       DateTime     @default(now())
  uploadedBy      User         @relation("SalesUploads", fields: [uploadedById], references: [id])

  @@index([createdAt])
}

/// Isolated receipt provenance used ONLY by Last Payment. No operational plan/season foreign key.
/// REGULAR batches may be superseded within scopeKey (SeasonMonth ID); HISTORICAL is append-only.
model LastPaymentImport {
  id           String               @id @default(cuid())
  kind         String
  scopeKey     String               @default("")
  fileHash     String
  workbookName String
  uploadedById String
  isActive     Boolean              @default(true)
  summary      String
  createdAt    DateTime             @default(now())
  uploadedBy   User                 @relation(fields: [uploadedById], references: [id])
  receipts     LastPaymentReceipt[]

  @@unique([kind, scopeKey, fileHash])
  @@index([kind, scopeKey, isActive])
}

/// Individual source rows, including distinct identical same-day receipts. A voucher number alone is NOT unique.
model LastPaymentReceipt {
  id            String            @id @default(cuid())
  importId      String
  dealerId      String
  rowKey        String
  sourceOrder   Int
  receiptDate   DateTime          @db.Date
  creditAmount  Decimal           @db.Decimal(14, 2)
  voucherNumber String?
  createdAt     DateTime          @default(now())
  dealer        Dealer            @relation(fields: [dealerId], references: [id])
  import        LastPaymentImport @relation(fields: [importId], references: [id])

  @@unique([importId, rowKey])
  @@index([dealerId, receiptDate])
}

/// One Recovery Plan per (season month, officer). The admin uploads the company Aging Report;
/// it is split by dealer assignment into a Draft RecoveryPlan per officer, who plans monthly &
/// weekly recovery and submits through the SAME approval workflow as Seasonal/Monthly.
model RecoveryPlan {
  id                  String               @id @default(cuid())
  seasonId            String
  seasonMonthId       String
  officerId           String
  cutoffDate          DateTime
  weeklyEditEnabled   Boolean              @default(true)
  status              PlanStatus           @default(DRAFT)
  submittedAt         DateTime?
  approvedAt          DateTime?
  lastSavedAt         DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lifecycleState      String               @default("ACTIVE")
  closedAt            DateTime?
  deactivatedAt       DateTime?
  seasonPlanId        String?
  lifecycleFromParent Boolean              @default(false)
  snapshots           AgingSnapshot[]
  actions             ApprovalAction[]
  officer             User                 @relation("OfficerRecoveryPlans", fields: [officerId], references: [id])
  season              Season               @relation(fields: [seasonId], references: [id])
  seasonMonth         SeasonMonth          @relation(fields: [seasonMonthId], references: [id])
  seasonPlan          SeasonPlan?          @relation(fields: [seasonPlanId], references: [id], onDelete: Restrict)
  dealers             RecoveryPlanDealer[]
  weekLocks           RecoveryWeekLock[]

  @@unique([seasonMonthId, officerId])
  @@index([seasonId])
  @@index([officerId])
  @@index([status])
  @@index([lifecycleState])
  @@index([seasonPlanId])
}

/// Admin manual lock/unlock override for ONE business week of a recovery plan. A row means an admin has
/// explicitly set the week's editability (`locked`), which takes priority over the automatic date-based
/// lock. No row → the week follows automatic date-based locking. Global to the plan (all users see it).
model RecoveryWeekLock {
  id             String       @id @default(cuid())
  recoveryPlanId String
  weekNo         Int
  locked         Boolean
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  recoveryPlan   RecoveryPlan @relation(fields: [recoveryPlanId], references: [id], onDelete: Cascade)

  @@unique([recoveryPlanId, weekNo])
  @@index([recoveryPlanId])
}

/// A dealer inside a Recovery Plan. Imported aging figures are READ-ONLY (refreshed from the
/// latest snapshot); the month recovery plan values are editable. Completed/Remaining derive
/// from the entered plan; only No Plan is stored (monthly analogue of PlanDealer.noPlan).
model RecoveryPlanDealer {
  id                   String             @id @default(cuid())
  recoveryPlanId       String
  dealerId             String
  outstanding          Decimal            @default(0) @db.Decimal(14, 2)
  overdue              Decimal            @default(0) @db.Decimal(14, 2)
  due                  Decimal            @default(0) @db.Decimal(14, 2)
  running              Decimal            @default(0) @db.Decimal(14, 2)
  monthRecoveryPlan    Decimal?           @db.Decimal(14, 2)
  monthRunningRecovery Decimal?           @db.Decimal(14, 2)
  noPlan               Boolean            @default(false)
  noPlanReason         String?
  outstandingTillDate  Decimal?           @db.Decimal(14, 2)
  runningTillDate      Decimal?           @db.Decimal(14, 2)
  srCr                 Decimal            @default(0) @db.Decimal(14, 2)
  liveRecovery         Decimal            @default(0) @db.Decimal(14, 2)
  outstandingStatic    Boolean            @default(false)
  noPlanReasonDetail   String?
  lastReceiptDate      DateTime?          @db.Date
  lastReceiptAmount    Decimal?           @db.Decimal(14, 2)
  dealer               Dealer             @relation(fields: [dealerId], references: [id])
  recoveryPlan         RecoveryPlan       @relation(fields: [recoveryPlanId], references: [id], onDelete: Cascade)
  weekPlans            RecoveryWeekPlan[]

  @@unique([recoveryPlanId, dealerId])
  @@index([recoveryPlanId])
  @@index([dealerId])
}

/// Week View — one editable row per (recovery dealer, week number 1..5).
model RecoveryWeekPlan {
  id                   String             @id @default(cuid())
  recoveryPlanDealerId String
  weekNo               Int
  weekRecoveryPlan     Decimal?           @db.Decimal(14, 2)
  weekRunningRecovery  Decimal?           @db.Decimal(14, 2)
  recoveryPlanDealer   RecoveryPlanDealer @relation(fields: [recoveryPlanDealerId], references: [id], onDelete: Cascade)

  @@unique([recoveryPlanDealerId, weekNo])
  @@index([recoveryPlanDealerId])
}

/// A point-in-time Aging Report upload. weekNo 0 = the initial month upload; 1..5 = weekly
/// re-uploads. Snapshots are NEVER overwritten, so historical reports stay available. The
/// change-tracking summary vs the previous snapshot is stored as small COUNTS only (not the
/// aging data — those live in the normalised dealer/bill tables below).
model AgingSnapshot {
  id             String                @id @default(cuid())
  recoveryPlanId String
  weekNo         Int
  cutoffDate     DateTime
  workbookName   String
  uploadedById   String
  summary        String?
  createdAt      DateTime              @default(now())
  recoveryPlan   RecoveryPlan          @relation(fields: [recoveryPlanId], references: [id], onDelete: Cascade)
  uploadedBy     User                  @relation("RecoveryUploads", fields: [uploadedById], references: [id])
  bills          AgingSnapshotBill[]
  dealers        AgingSnapshotDealer[]

  @@unique([recoveryPlanId, weekNo])
  @@index([recoveryPlanId])
}

/// Per-dealer aging aggregate within a snapshot (bucketed by the snapshot's cutoff date).
model AgingSnapshotDealer {
  id          String              @id @default(cuid())
  snapshotId  String
  dealerId    String
  outstanding Decimal             @default(0) @db.Decimal(14, 2)
  overdue     Decimal             @default(0) @db.Decimal(14, 2)
  due         Decimal             @default(0) @db.Decimal(14, 2)
  running     Decimal             @default(0) @db.Decimal(14, 2)
  bills       AgingSnapshotBill[]
  snapshot    AgingSnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, dealerId])
  @@index([snapshotId])
  @@index([dealerId])
}

/// One normalised bill row within a snapshot — the raw Aging Report data (never JSON). Enables
/// future features (payment history, actual recovery) without schema changes.
model AgingSnapshotBill {
  id               String              @id @default(cuid())
  snapshotId       String
  snapshotDealerId String
  dealerId         String
  billDate         DateTime?
  refNo            String?
  amount           Decimal             @db.Decimal(14, 2)
  dueDate          DateTime?
  bucket           String
  snapshotDealer   AgingSnapshotDealer @relation(fields: [snapshotDealerId], references: [id], onDelete: Cascade)
  snapshot         AgingSnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([snapshotDealerId])
  @@index([dealerId])
}

/// Configurable pack sizes used in planning (replaces the workbook's seven fixed
/// columns). Managed by the Super Admin like Categories and Brands.
model PackSize {
  id            String         @id @default(cuid())
  name          String         @unique
  displayOrder  Int            @default(0)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isPlanning    Boolean        @default(false)
  planLinePacks PlanLinePack[]

  @@index([isActive])
  @@index([isPlanning])
}

/// In-app notification. Created directly by business workflows (no queues/workers).
model Notification {
  id                String           @id @default(cuid())
  userId            String
  type              NotificationType
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean          @default(false)
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
}

/// Lightweight audit record for a Dealer Import run. Metadata only — the uploaded
/// workbook is never stored.
model DealerImportRecord {
  id                String       @id @default(cuid())
  importedById      String
  workbookName      String
  dealerCount       Int          @default(0)
  createdDealers    Int          @default(0)
  reassignedDealers Int          @default(0)
  skippedDealers    Int          @default(0)
  officersCreated   Int          @default(0)
  status            ImportStatus
  summary           String?
  createdAt         DateTime     @default(now())
  importedBy        User         @relation(fields: [importedById], references: [id])

  @@index([createdAt])
}

/// Tracks which users have read which announcements.
model AnnouncementReadStatus {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@index([userId])
}

/// Single trusted owner, bound to an existing stable User ID during reviewed deployment.
/// Generic settings/profile/user-edit APIs cannot alter this record.
model AccountManagementOwner {
  id     String @id @default("primary")
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

enum Role {
  SUPER_ADMIN
  REGIONAL_MANAGER
  SALES_OFFICER
  CUSTOM_ADMIN
}

enum SeasonStatus {
  OPEN
  CLOSED
}

enum SchemeStatus {
  OPEN
  CLOSED
}

enum SchemeBenefit {
  DOMESTIC_TOUR
  DOMESTIC_COUPLE_TOUR
  FOREIGN_TOUR
  CREDIT_NOTE
  OTHER
}

enum SchemeCalcType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum SchemePlanStatus {
  DRAFT
  SUBMITTED
  RM_APPROVED
  RM_REJECTED
  RETURNED
}

enum SchemeEnrollmentStatus {
  PENDING_DOCUMENT
  ENROLLED
}

enum SchemeDocType {
  SOFT_COPY
  HARD_COPY
}

enum SchemePlanState {
  DRAFT
  PENDING_RM
  PENDING_APPROVAL
  APPROVED
  RETURNED
  REJECTED
}

enum SchemeConversionStatus {
  PENDING
  CONVERTED
  DECLINED
}

enum SchemePlanRemainderDisposition {
  CANCELLED
  FUTURE_DRAFT
}

enum SchemeBookingStatus {
  RECEIVED
  NOT_RECEIVED
  PARTIAL
}

enum SchemeSoDocStatus {
  SIGNED_BUT_NOT_SENT
  SIGNED_AND_SENT
  HARD_COPY_SENT
  DOC_RECEIVED
}

enum SchemeAdminDocStatus {
  RECEIVED_SOFT
  RECEIVED_HARD
  NOT_RECEIVED
}

enum SchemeRequirementType {
  NONE
  PRODUCT_BASED
  VALUE_BASED
}

enum SchemeValueMode {
  INDIVIDUAL
  COMBINED
}

/// Lifecycle of a scheme-upload scope / its tracked sales: ACTIVE = authoritative; SUPERSEDED = replaced
/// by a later upload of the same scheme+range (kept for audit, never counted).
enum SchemeUploadStatus {
  ACTIVE
  SUPERSEDED
}

/// Scheme structure (Phase 10). FIXED = the original single-configuration scheme (unchanged behaviour).
/// MULTIPLE_OPTIONS = one scheme offering several predefined options; a dealer commits to exactly one.
enum SchemeStructure {
  FIXED
  MULTIPLE_OPTIONS
}

/// Achievement type for MULTIPLE_OPTIONS schemes. The option target is a single combined total across the
/// eligible product pool — quantity (sum of eligible-product qty) or value (sum of eligible-product sales).
enum SchemeOptionAchievementType {
  QUANTITY_BASED
  VALUE_BASED
}

enum PlanStatus {
  DRAFT
  PENDING_RM
  PENDING_ADMIN
  APPROVED
  RETURNED
  REJECTED
}

enum ApprovalActionType {
  SUBMIT
  RECALL
  APPROVE
  RETURN
  REJECT
  REQUEST_REVISION
  AUTHORIZE_REVISION
}

enum NotificationType {
  PLAN_SUBMITTED
  PLAN_APPROVED
  PLAN_RETURNED
  REVISION_AUTHORIZED
  ANNOUNCEMENT
  SYSTEM
  MONTH_EXTENSION_REQUESTED
  MONTH_EXTENSION_APPROVED
}

enum ImportStatus {
  COMPLETED
  FAILED
  ROLLED_BACK
}

/// Market master (Party Planning · Territory Mapping). The single authoritative Market list: a Market has a stable id that Dealer
/// mappings — and, in later phases, Seasonal / Monthly Planning — reference, so no later module duplicates Market records. A Market only
/// exists once it is usable: it is created either by an approved MarketRequest (source REQUESTED) or by mapping existing dealers
/// (Excel import, source EXISTING). `potential` is the MARKET-level A/B/C (set by an approved request; null until decided for
/// markets that came from the import) and is deliberately separate from the dealer-level potential in DealerMarketMapping.
/// The legacy free-text `marketName` columns (PartyPlan / Daily Work / Calendar) are untouched.
model Market {
  id                String                @id @default(cuid())
  name              String
  /// Normalized name (lower-case, punctuation/space collapsed) — the duplicate guard: "Pipariya" == "pipariya " == "PIPARIYA".
  nameKey           String                @unique
  potential         String? // A | B | C
  source            String                @default("EXISTING") // EXISTING | REQUESTED
  expectedParties   Int? // "No. of Parties" from the approved request
  createdById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  mappings          DealerMarketMapping[]
  requests          MarketRequest[]
  seasonalPlans     SeasonalPlan[]
  partyMonthlyPlans PartyMonthlyPlan[]
}

/// One CURRENT Territory Mapping row per dealer (dealerId unique): the dealer's Market (nullable — unmapped dealers can still carry
/// a Potential) and the dealer-level Potential A/B/C chosen in the mapping exercise. History of changes is kept in the audit log.
model DealerMarketMapping {
  id          String    @id @default(cuid())
  dealerId    String    @unique
  marketId    String?
  /// TEMPORARY manual override of the displayed Market (free text from the Existing Dealers screen). It is NOT a Market master record and
  /// never feeds Seasonal / Monthly Planning; an Excel import that changes the Market clears it. Each manual change is in TerritoryMarketEdit.
  marketText  String?
  /// LEGACY free text (kept — never dropped or blindly overwritten). Once `districtId` is set this mirrors the District master's name; a row with text but no districtId is an unresolved legacy value awaiting review.
  district    String?
  /// The standard District (District master, belongs to one State = UserGroup). Null = none chosen yet.
  districtId  String?
  potential   String? // A | B | C — dealer-level, NOT the Market's potential
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dealer      Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  market      Market?   @relation(fields: [marketId], references: [id], onDelete: SetNull)
  districtRef District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  @@index([marketId])
  @@index([districtId])
}

/// Append-only history of MANUAL Market edits on Existing Dealers (one row per confirmed change; Excel imports never write here).
/// Rows are never updated or deleted (database trigger).
model TerritoryMarketEdit {
  id             String   @id @default(cuid())
  dealerId       String
  previousMarket String?
  newMarket      String
  editedById     String
  editedAt       DateTime @default(now())
  dealer         Dealer   @relation(fields: [dealerId], references: [id])
  editedBy       User     @relation("TerritoryMarketEditor", fields: [editedById], references: [id])

  @@index([dealerId, editedAt])
}

/// "Add Market" request: SO → RM review → Admin review → approved Market. An RM's own request goes straight to Admin review.
/// status: PENDING_RM | PENDING_ADMIN | APPROVED | REJECTED. Every decision (user, time, reason) is retained on the row.
model MarketRequest {
  id               String    @id @default(cuid())
  requesterId      String
  marketName       String
  nameKey          String
  potential        String // A | B | C
  numberOfParties  Int
  status           String // PENDING_RM | PENDING_ADMIN | APPROVED | REJECTED
  rmDecision       String? // APPROVED | REJECTED
  rmDecidedById    String?
  rmDecidedAt      DateTime?
  adminDecision    String? // APPROVED | REJECTED
  adminDecidedById String?
  adminDecidedAt   DateTime?
  rejectionStage   String? // RM | ADMIN
  rejectionReason  String?
  marketId         String? // the Market created on final approval
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  requester        User      @relation("MarketRequestRequester", fields: [requesterId], references: [id])
  market           Market?   @relation(fields: [marketId], references: [id])

  @@index([requesterId])
  @@index([status])
  @@index([nameKey])
}

/// Seasonal Planning (Party Planning · Phase 2): an owner (Sales Officer / Regional Manager) plans, for the CURRENT Sales Planning
/// season, which Market they will develop a party in. `seasonId` is the existing Season (no second season master) and `marketId` the
/// Phase-1 Market (no second market list) — so Monthly Planning (Phase 3) can hang off SeasonalPlan.id and read its months from
/// Season.months without keeping its own market list. Type (Existing / New) is DERIVED from Market.source and Market Potential from
/// Market.potential; they are snapshotted into approved* only at final Admin approval, so an approved plan keeps what Admin approved.
/// approvalStatus: DRAFT → PENDING_RM → PENDING_ADMIN → APPROVED | REJECTED (an RM's own plan skips PENDING_RM).
/// appointmentStatus stays NULL ("—") until final approval, then PENDING. APPOINTED + appointedAt are reserved for the actual
/// appointment event — no workflow sets them yet (the repo has no Admin-confirmed appointment event), approval never does.
model SeasonalPlan {
  id                      String             @id @default(cuid())
  sheetId                 String
  seasonId                String
  ownerId                 String
  marketId                String
  /// RETIRED: Seasonal Planning no longer asks for a party name. Kept nullable (not dropped) so historical entries keep their original value; nothing reads or writes it.
  partyName               String?
  approvalStatus          String             @default("DRAFT")
  rmDecidedById           String?
  rmDecidedAt             DateTime?
  adminDecidedById        String?
  adminDecidedAt          DateTime?
  rejectionStage          String? // RM | ADMIN
  rejectionReason         String?
  approvedMarketSource    String? // Market.source at final approval
  approvedMarketPotential String? // Market.potential at final approval
  appointmentStatus       String? // NULL | PENDING | APPOINTED
  appointedAt             DateTime?          @db.Date
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  season                  Season             @relation(fields: [seasonId], references: [id])
  owner                   User               @relation("SeasonalPlanOwner", fields: [ownerId], references: [id])
  market                  Market             @relation(fields: [marketId], references: [id])
  monthlyPlans            PartyMonthlyPlan[]
  sheet                   SeasonalPlanSheet  @relation(fields: [sheetId], references: [id])

  @@index([sheetId])
  @@index([seasonId])
  @@index([ownerId])
  @@index([marketId])
  @@index([approvalStatus])
}

/// Party Planning · Monthly Planning (Phase 3). NOT the Sales Planning `MonthlyPlan`. One row = one approved Seasonal Plan planned for one
/// SeasonMonth of its season: the market list is therefore the Seasonal Plan's (never an independent list) and the month is a real
/// SeasonMonth of the season (never free text). Exactly one row per (seasonalPlanId, seasonMonthId). Market name / potential are snapshotted
/// at creation so history still reads correctly if the Market master changes later. `planDate` is the TENTATIVE plan date; the actual
/// appointment lives on the options. Two independent options hang off it (PartyMonthlyOption); every change is an append-only
/// PartyMonthlyEvent. Nothing here is ever cascaded away.
model PartyMonthlyPlan {
  id                        String                    @id @default(cuid())
  sheetId                   String
  seasonalPlanId            String
  seasonId                  String
  seasonMonthId             String
  ownerId                   String
  marketId                  String
  marketNameAtPlanning      String
  marketPotentialAtPlanning String?
  planDate                  DateTime?                 @db.Date
  /// ONE operational status per market row (Option 1 / 2 are only candidate names): NONE → DOC_SENT → DOC_RECEIVED → SD_BOUNCE / APPOINTED / REJECTED.
  /// NONE = the workflow has not begun (the table then shows Draft / Submitted / Approved from the plan). Each change is a PartyMonthlyStatusEvent.
  opStatus                  String                    @default("NONE")
  opStatusChangedAt         DateTime?
  /// Entry-level approval (like Seasonal): DRAFT → PENDING_RM → PENDING_ADMIN → APPROVED | REJECTED. A Monthly Plan (owner + month) is ONE logical plan whose entries
  /// are submitted and approved in batches, so the same plan accumulates entries under Submitted and Approved while Create stays open for more.
  approvalStatus            String                    @default("DRAFT")
  submittedAt               DateTime?
  rmDecidedById             String?
  rmDecidedAt               DateTime?
  adminDecidedById          String?
  adminDecidedAt            DateTime?
  rejectionStage            String?
  rejectionReason           String?
  /// the Dealer created when this row was marked Appointed (via the Dealer Alias create-dealer service)
  appointedDealerId         String?
  appointedDealer           Dealer?                   @relation("PartyMonthlyAppointedDealer", fields: [appointedDealerId], references: [id], onDelete: SetNull)
  statusEvents              PartyMonthlyStatusEvent[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  seasonalPlan              SeasonalPlan              @relation(fields: [seasonalPlanId], references: [id])
  season                    Season                    @relation(fields: [seasonId], references: [id])
  seasonMonth               SeasonMonth               @relation(fields: [seasonMonthId], references: [id])
  owner                     User                      @relation("PartyMonthlyPlanOwner", fields: [ownerId], references: [id])
  market                    Market                    @relation(fields: [marketId], references: [id])
  options                   PartyMonthlyOption[]
  events                    PartyMonthlyEvent[]
  dateChanges               PartyMonthlyDateChange[]
  sheet                     PartyMonthlySheet         @relation(fields: [sheetId], references: [id])

  @@unique([seasonalPlanId, seasonMonthId])
  @@index([sheetId])
  @@index([seasonId])
  @@index([ownerId])
  @@index([seasonMonthId])
}

/// Append-only history of every change to a Monthly Plan row's Conversion Date (`planDate`): previous → new, who, when, and whether it was an
/// Admin action (byAdmin). The SO change count = rows with byAdmin=false; the date is "Admin-confirmed" while the LATEST row is an Admin one.
/// Rows are never updated or deleted (database trigger).
model PartyMonthlyDateChange {
  id            String           @id @default(cuid())
  monthlyPlanId String
  previousDate  DateTime?        @db.Date
  newDate       DateTime?        @db.Date
  byAdmin       Boolean
  /// true when the date was set automatically by a status change (not edited by hand)
  automatic     Boolean          @default(false)
  actorId       String
  actorName     String
  actorRole     String
  createdAt     DateTime         @default(now())
  monthlyPlan   PartyMonthlyPlan @relation(fields: [monthlyPlanId], references: [id])

  @@index([monthlyPlanId, createdAt])
}

/// Append-only history of a market row's operational status: previous → new, actor, time, remarks, and what the SO said was sent / Admin said was received.
/// Rows are never updated or deleted (database trigger).
model PartyMonthlyStatusEvent {
  id             String           @id @default(cuid())
  monthlyPlanId  String
  previousStatus String
  newStatus      String
  /// set on the Appointed event: the Dealer created in the same transaction
  dealerId       String?
  actorId        String
  actorName      String
  actorRole      String
  remarks        String?
  sentInfo       Json?
  receivedInfo   Json?
  createdAt      DateTime         @default(now())
  monthlyPlan    PartyMonthlyPlan @relation(fields: [monthlyPlanId], references: [id])

  @@index([monthlyPlanId, createdAt])
}

/// Option 1 / Option 2 of a PartyMonthlyPlan — two candidate parties with INDEPENDENT lifecycles.
/// status: PENDING → DOC_SENT → DOC_RECEIVED → SD_DELAYED_BY_SO / SD_BOUNCE → APPOINTED, or PART_REJECTED (see src/lib/monthly-plan.ts).
/// sentInfo (what the SO marked as sent) and receivedInfo (what Admin recorded as received) are separate and never overwrite each other.
model PartyMonthlyOption {
  id                String              @id @default(cuid())
  monthlyPlanId     String
  optionNo          Int // 1 | 2
  partyName         String? // tentative candidate party
  status            String              @default("PENDING")
  sentInfo          Json?
  sentById          String?
  sentAt            DateTime?
  receivedInfo      Json?
  receivedById      String?
  receivedAt        DateTime?
  actualPartyName   String? // the correct party name per the appointment documents (may differ from partyName)
  actualAppointedOn DateTime?           @db.Date
  rejectionReason   String?
  statusChangedAt   DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  monthlyPlan       PartyMonthlyPlan    @relation(fields: [monthlyPlanId], references: [id])
  events            PartyMonthlyEvent[]

  @@unique([monthlyPlanId, optionNo])
}

/// Append-only timeline. Rows are only ever INSERTed (a database trigger refuses UPDATE and DELETE). Each event stores structured
/// details plus the actor's name/role at the time, so the history never depends on the current row status or on later renames.
model PartyMonthlyEvent {
  id            String             @id @default(cuid())
  monthlyPlanId String
  optionId      String
  eventType     String // PLAN_CREATED | PARTY_UPDATED | STATUS_CHANGED
  fromStatus    String?
  toStatus      String
  actorId       String
  actorName     String
  actorRole     String
  details       Json?
  createdAt     DateTime           @default(now())
  monthlyPlan   PartyMonthlyPlan   @relation(fields: [monthlyPlanId], references: [id])
  option        PartyMonthlyOption @relation(fields: [optionId], references: [id])

  @@index([monthlyPlanId])
  @@index([optionId, createdAt])
}

/// Party Planning list/detail header (Seasonal): one Seasonal Plan = one owner's plan for ONE selected Season, holding their market rows
/// (SeasonalPlan). The season is chosen when the plan is created (an OPEN season) and never re-derived from "today". Status and "last
/// saved" are derived from the rows, so approval stays row-level exactly as before. One sheet per (owner, season).
model SeasonalPlanSheet {
  id        String         @id @default(cuid())
  seasonId  String
  ownerId   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  season    Season         @relation(fields: [seasonId], references: [id])
  owner     User           @relation("SeasonalSheetOwner", fields: [ownerId], references: [id])
  items     SeasonalPlan[]

  @@unique([ownerId, seasonId])
  @@index([seasonId])
}

/// Party Planning list/detail header (Monthly): one Monthly Plan = one owner's plan for ONE Season + ONE SeasonMonth, holding their
/// market rows (PartyMonthlyPlan). One sheet per (owner, SeasonMonth).
model PartyMonthlySheet {
  id               String             @id @default(cuid())
  seasonId         String
  seasonMonthId    String
  ownerId          String
  /// Plan-level approval (separate from each option's own lifecycle): DRAFT → PENDING_RM → PENDING_ADMIN → APPROVED | REJECTED (same steps as Seasonal).
  approvalStatus   String             @default("DRAFT")
  submittedAt      DateTime?
  rmDecidedById    String?
  rmDecidedAt      DateTime?
  adminDecidedById String?
  adminDecidedAt   DateTime?
  rejectionStage   String?
  rejectionReason  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  season           Season             @relation(fields: [seasonId], references: [id])
  seasonMonth      SeasonMonth        @relation(fields: [seasonMonthId], references: [id])
  owner            User               @relation("PartyMonthlySheetOwner", fields: [ownerId], references: [id])
  items            PartyMonthlyPlan[]

  @@unique([ownerId, seasonMonthId])
  @@index([seasonId])
}

/// District master: the official districts of ONE State. The State is the existing UserGroup (State Catalogue is per group), so a district is
/// unique within its state (`nameKey` = normalized name) while the same name may exist in another state. Districts are never deleted by an
/// upload; `isActive=false` hides one from the Territory Mapping dropdown without touching dealers that already use it.
model District {
  id          String                @id @default(cuid())
  groupId     String
  name        String
  nameKey     String
  isActive    Boolean               @default(true)
  createdById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  group       UserGroup             @relation(fields: [groupId], references: [id], onDelete: Restrict)
  aliases     DistrictAlias[]
  mappings    DealerMarketMapping[]

  @@unique([groupId, nameKey])
  @@index([groupId, isActive])
}

/// An APPROVED alternative spelling of a district ("Barabanki" for "Bara Banki"), unique within the state. Used only to resolve imported /
/// legacy text to the canonical district — never shown as a separate choice.
model DistrictAlias {
  id         String   @id @default(cuid())
  districtId String
  groupId    String
  alias      String
  aliasKey   String
  createdAt  DateTime @default(now())
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([groupId, aliasKey])
  @@index([districtId])
}
