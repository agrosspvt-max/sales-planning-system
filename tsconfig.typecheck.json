{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "incremental": false,
    "paths": {
      "@/*": ["./src/*"],
      "@prisma/client": ["./typecheck/prisma-client.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "typecheck/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
